### 1. Créer une nouvelle compétence
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation CreateCompetence($input: CreateCompetenceInput!) { createCompetence(input: $input) { id nom niveau categorie { id nom } } }",
  "variables": {
    "input": {
      "nom": "React",
      "niveau": 85,
      "categorie": "CATEGORIE_ID_HERE"
    }
  }
}

### 2. Récupérer toutes les compétences
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query GetCompetences { getCompetences { id nom niveau categorie { id nom } } }"
}

### 3. Récupérer une compétence par ID
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query GetCompetence($id: ID!) { getCompetence(id: $id) { id nom niveau categorie { id nom } } }",
  "variables": {
    "id": "COMPETENCE_ID_HERE"
  }
}

### 4. Mettre à jour une compétence
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation UpdateCompetence($id: ID!, $input: UpdateCompetenceInput!) { updateCompetence(id: $id, input: $input) { id nom niveau categorie { id nom } } }",
  "variables": {
    "id": "COMPETENCE_ID_HERE",
    "input": {
      "nom": "React Advanced",
      "niveau": 95
    }
  }
}

### 5. Supprimer une compétence
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation DeleteCompetence($id: ID!) { deleteCompetence(id: $id) }",
  "variables": {
    "id": "COMPETENCE_ID_HERE"
  }
}


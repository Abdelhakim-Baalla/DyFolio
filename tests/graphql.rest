### GraphQL Mutation - register
POST http://localhost:3895/graphql
Content-Type: application/json

{
  "query": "mutation ($input: RegisterInput!) { register(input: $input) { token user { id username email } } }",
  "variables": { "input": { "username": "testuser", "email": "test@example.com", "password": "password123", "nom": "Test", "prenom": "User", "metier": "Développeur" } }
}

